# Production Email / SMTP Configuration for TechPros ITSM
# Set these environment variables in your production environment
# (Cloudflare Workers secrets, Vercel env, or .env file for local dev).

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
FROM_EMAIL=noreply@techpros-itsm.com
FROM_NAME=TechPros ITSM

# Email templates directory (optional — for HTML templates)
# EMAIL_TEMPLATES_DIR=./email-templates

# Notification preferences
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false

# Rate limits for email sending (to prevent abuse)
EMAIL_RATE_LIMIT_WINDOW=3600  # 1 hour
EMAIL_RATE_LIMIT_MAX=100       # max emails per window

# Production notes:
# - Replace SMTP_PASS with your real SMTP provider key (SendGrid, Mailgun, Postmark, AWS SES)
# - Ensure FROM_EMAIL domain is verified with your email provider
# - For Cloudflare Workers, set these via: wrangler secret put SMTP_PASS
# - For Vercel, set these in the Vercel dashboard environment variables
