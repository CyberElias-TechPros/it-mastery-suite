{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://techpros-api.your-account.workers.dev/api"
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://techpros-api.your-account.workers.dev/api"
    }
  }
}
