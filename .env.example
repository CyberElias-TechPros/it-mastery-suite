# Frontend environment variables (Vite). Copy to .env.local for local development.
#
# Base URL of the Cloudflare Workers API.
#   local dev  : leave unset — vite proxies /api to http://127.0.0.1:8787
#   preview    : https://itsm-api-preview.<subdomain>.workers.dev/api
#   production : https://api.yourdomain.com/api
VITE_API_BASE_URL=
